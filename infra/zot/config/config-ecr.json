{
  "distSpecVersion": "1.1.0",
  "storage": { "rootDirectory": "/var/lib/registry", "gc": true, "gcDelay": "1h", "gcInterval": "24h" },
  "http": { "address": "0.0.0.0", "port": "5000" },
  "log": { "level": "info" },
  "extensions": {
    "sync": {
      "registries": [
        { "urls": ["https://public.ecr.aws"], "onDemand": true, "tlsVerify": true, "content": [{ "prefix": "**" }] }
      ]
    }
  }
}
