flowchart TD
    subgraph k8s["Kubernetes Control Plane · root of trust"]
        APISERVER["Kubernetes API Server"]
        PSAT["Projected Service Account Token\nissued to spire-agent pod\n(SA: spire:spire-agent)"]
        TR["TokenReview API\nauthentication.k8s.io/tokenreviews"]
        BUNDLE["spire-bundle ConfigMap\nCA cert — written by SPIRE Server,\nread by Agent on startup"]
    end

    subgraph spire_tcb["SPIRE Trusted Computing Base · trust derived from Kubernetes"]
        SERVER["SPIRE Server\nCA + SQLite registration DB\ntrusted via spire-server SA + RBAC"]
        AGENT["SPIRE Agent\nnode + workload attestor\ntrusted via spire-agent SA + RBAC"]
        NODE_SVID["Node SVID\nspiffe://ipc.local/k8s-node"]
        PEERCRED["SO_PEERCRED → PID\n/proc/pid/cgroup + kubelet API\n(nodes/proxy)"]
        REG["Registration Entry\nns: spire-demo / sa: demo-sa\n→ spiffe://ipc.local/demo-app\n(continuously reconciled)"]
    end

    subgraph mgmt["GitOps / Management Plane · configures policy, does not hold secrets"]
        GIT["Git + Flux\nClusterSPIFFEID manifest\ndeclared in repo"]
        CRD["ClusterSPIFFEID CR\nspiffeIDTemplate: spiffe://ipc.local/demo-app\npodSelector: app=demo-workload\nnamespaceSelector: spire-demo"]
        CTRL["SPIRE Controller Manager\nwatches ClusterSPIFFEID CRs\nreconciles → SPIRE entries"]
    end

    subgraph workload["Workload · untrusted until attested"]
        POD["Demo Workload Pod\nnamespace: spire-demo\nserviceAccount: demo-sa"]
        SOCK["Workload API Socket\n/run/spire/sockets/agent.sock"]
        SVID["X.509 SVID\nspiffe://ipc.local/demo-app\nsigned by SPIRE CA"]
    end

    APISERVER -->|"issues PSAT to pod"| PSAT
    PSAT -->|"agent presents on startup"| SERVER
    SERVER -->|"validates via"| TR
    TR -->|"calls back to"| APISERVER
    SERVER -->|"writes CA cert to"| BUNDLE
    BUNDLE -->|"agent reads to bootstrap TLS"| AGENT
    SERVER -->|"grants"| NODE_SVID
    NODE_SVID -->|"held by"| AGENT

    GIT -->|"Flux applies CR"| CRD
    CRD -->|"watched by"| CTRL
    CTRL -->|"reads CR spec from"| APISERVER
    CTRL -->|"reconciles entries into"| SERVER
    REG -.->|"kept in sync by"| CTRL

    POD -->|"calls"| SOCK
    SOCK -->|"received by"| AGENT
    AGENT -->|"resolves caller via"| PEERCRED
    PEERCRED -->|"matched against"| REG
    REG -->|"agent issues"| SVID
    SVID -->|"returned to"| POD

