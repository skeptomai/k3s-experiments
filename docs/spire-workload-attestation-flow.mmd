flowchart LR
    subgraph k8s["Kubernetes Control Plane"]
        APISERVER["API Server"]
        KUBELET["Kubelet\n/pods endpoint"]
    end

    subgraph workload_creation["Workload Creation"]
        MANIFEST["kubectl apply\nPod manifest\nns: spire-demo\nsa: demo-sa"]
        POD["Pod scheduled\n+ started"]
        SOCK_MOUNT["agent.sock\nmounted via hostPath\n/run/spire/sockets/"]
    end

    subgraph node_tcb["SPIRE Agent (same node — hostPID: true)"]
        PEERCRED["① SO_PEERCRED\nkernel returns host PID\nof connecting process\n(cannot be forged)"]
        CGROUP["② /proc/&lt;pid&gt;/cgroup\nparse container ID\nfrom cgroup path\n0::/kubepods/.../&lt;container-id&gt;"]
        KUBELET_CALL["③ kubelet /pods API\ncontainer ID →\npod namespace + service account\n+ labels + annotations"]
        MATCH["④ match pod metadata\nagainst registration entries\nns=spire-demo, sa=demo-sa"]
        ISSUE["⑤ issue X.509 SVID\nspiffe://ipc.local/demo-app\n(workload never self-identified)"]
    end

    subgraph spire_server["SPIRE Server"]
        REG["Registration Entry\nns: spire-demo / sa: demo-sa\n→ spiffe://ipc.local/demo-app"]
    end

    subgraph workload_runtime["Workload (running)"]
        CALL["connect to\n/run/spire/sockets/agent.sock"]
        SVID["receive X.509 SVID\nspiffe://ipc.local/demo-app"]
        USE["use SVID for\nmTLS / Vault auth / etc."]
    end

    MANIFEST -->|"admitted + scheduled"| APISERVER
    APISERVER -->|"start pod"| KUBELET
    KUBELET -->|"launches container"| POD
    POD -->|"hostPath volume"| SOCK_MOUNT
    SOCK_MOUNT -->|"socket available to"| CALL

    CALL -->|"connect"| PEERCRED
    PEERCRED -->|"host PID"| CGROUP
    CGROUP -->|"container ID"| KUBELET_CALL
    KUBELET_CALL -->|"queries"| KUBELET
    KUBELET -->|"pod namespace +\nservice account"| KUBELET_CALL
    KUBELET_CALL -->|"pod identity"| MATCH
    MATCH -->|"looks up"| REG
    REG -->|"entry found"| ISSUE
    ISSUE -->|"SVID delivered"| SVID
    SVID --> USE

