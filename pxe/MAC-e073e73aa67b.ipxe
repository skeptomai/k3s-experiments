#!ipxe
# ipc7 — e0:73:e7:3a:a6:7b — Ubuntu 26.04 trial (other nodes are 24.04.4)
set nb      http://192.168.89.2:31011
set kurl    ${nb}/ubuntu-squash/releases/download/26.04
set iso     ${nb}/ubuntu-26.04-live-server-amd64.iso
set install_params autoinstall ds=nocloud-net;s=${nb}/autoinstall/e0-73-e7-3a-a6-7b/

imgfree
echo Booting Ubuntu 26.04 autoinstall for ipc7
kernel ${kurl}/vmlinuz root=/dev/ram0 ramdisk_size=3500000 cloud-config-url=/dev/null ip=dhcp url=${iso} ${install_params} initrd=initrd.magic
initrd ${kurl}/initrd
boot
