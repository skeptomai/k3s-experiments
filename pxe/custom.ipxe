#!ipxe
# ipc node autoinstall — matches by MAC and boots the right config automatically.
# Falls through to the normal netboot.xyz menu for any non-ipc machine.
# Paste into the custom.ipxe file in the netboot.xyz web UI Menus section.

set nb   http://192.168.89.2:31011
set kurl ${nb}/ubuntu-squash/releases/download/24.04.4-717d3a1a
set iso  ${nb}/ubuntu-24.04.4-live-server-amd64.iso

iseq ${net0/mac} a8:a1:59:43:2a:67 && set ai ${nb}/autoinstall/a8-a1-59-43-2a-67/ && goto install ||
iseq ${net0/mac} a8:a1:59:43:2a:ed && set ai ${nb}/autoinstall/a8-a1-59-43-2a-ed/ && goto install ||
iseq ${net0/mac} a8:a1:59:43:2a:74 && set ai ${nb}/autoinstall/a8-a1-59-43-2a-74/ && goto install ||
exit 0

:install
imgfree
echo Installing Ubuntu 24.04 on ${net0/mac}
echo Autoinstall config: ${ai}
sleep 2
kernel ${kurl}/vmlinuz root=/dev/ram0 ramdisk_size=3500000 cloud-config-url=/dev/null ip=dhcp url=${iso} autoinstall ds=nocloud-net\;s=${ai} initrd=initrd.magic
initrd ${kurl}/initrd
boot
