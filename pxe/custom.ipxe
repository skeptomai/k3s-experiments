#!ipxe
# ipc node autoinstall — matches by MAC and boots the right config automatically.
# Falls through to the normal netboot.xyz menu for any non-ipc machine.
# Paste into the custom.ipxe file in the netboot.xyz web UI Menus section.
#
# Default kernel/ISO is Ubuntu 24.04.4. Nodes on 26.04 override kurl/iso below.
# On 26.04: ipc2, ipc3, ipc4, ipc5, ipc6 — only ipc1 (control plane) on 24.04.

set nb   http://192.168.89.2:31011
set kurl ${nb}/ubuntu-squash/releases/download/24.04.4-717d3a1a
set iso  ${nb}/ubuntu-24.04.4-live-server-amd64.iso

iseq ${net0/mac} a8:a1:59:43:2a:67 && set ai ${nb}/autoinstall/a8-a1-59-43-2a-67/ && goto install ||
iseq ${net0/mac} a8:a1:59:43:2a:ed && set kurl ${nb}/ubuntu-squash/releases/download/26.04 && set iso ${nb}/ubuntu-26.04-live-server-amd64.iso && set ai ${nb}/autoinstall/a8-a1-59-43-2a-ed/ && goto install ||
iseq ${net0/mac} a8:a1:59:43:2a:74 && set kurl ${nb}/ubuntu-squash/releases/download/26.04 && set iso ${nb}/ubuntu-26.04-live-server-amd64.iso && set ai ${nb}/autoinstall/a8-a1-59-43-2a-74/ && goto install ||
iseq ${net0/mac} d0:ad:08:9c:d2:cb && set kurl ${nb}/ubuntu-squash/releases/download/26.04 && set iso ${nb}/ubuntu-26.04-live-server-amd64.iso && set ai ${nb}/autoinstall/d0-ad-08-9c-d2-cb/ && goto install ||
iseq ${net0/mac} d0:ad:08:9c:d1:45 && set kurl ${nb}/ubuntu-squash/releases/download/26.04 && set iso ${nb}/ubuntu-26.04-live-server-amd64.iso && set ai ${nb}/autoinstall/d0-ad-08-9c-d1-45/ && goto install ||
iseq ${net0/mac} e0:73:e7:c0:b0:08 && set kurl ${nb}/ubuntu-squash/releases/download/26.04 && set iso ${nb}/ubuntu-26.04-live-server-amd64.iso && set ai ${nb}/autoinstall/e0-73-e7-c0-b0-08/ && goto install ||
exit 0

:install
imgfree
echo Installing Ubuntu 24.04 on ${net0/mac}
echo Autoinstall config: ${ai}
sleep 2
kernel ${kurl}/vmlinuz root=/dev/ram0 ramdisk_size=3500000 cloud-config-url=/dev/null ip=dhcp url=${iso} autoinstall ds=nocloud-net\;s=${ai} initrd=initrd.magic
initrd ${kurl}/initrd
boot
